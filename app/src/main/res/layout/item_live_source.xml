<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/vs_5"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_5"
    android:paddingRight="@dimen/vs_5">

    <TextView
        android:id="@+id/tvSourceName"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vs_5"
        android:layout_marginRight="@dimen/vs_5"
        android:layout_weight="1.5"
        android:background="@drawable/button_danmu_setting"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:padding="@dimen/vs_10"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_24"
        tools:text="测试直播源" />

    <TextView
        android:id="@+id/tvSourceUrl"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vs_5"
        android:layout_marginRight="@dimen/vs_5"
        android:layout_weight="3"
        android:background="@drawable/button_danmu_setting"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:padding="@dimen/vs_10"
        android:textColor="@color/dialog_text_hint"
        android:textSize="@dimen/ts_20"
        tools:text="https://example.com/api.json" />

    <TextView
        android:id="@+id/btnEdit"
        android:layout_width="@dimen/vs_60"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vs_5"
        android:layout_marginRight="@dimen/vs_5"
        android:background="@drawable/button_danmu_setting"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/vs_10"
        android:text="编辑"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_20" />

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="@dimen/vs_60"
        android:layout_height="wrap_content"
        android:background="@drawable/button_danmu_setting"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/vs_10"
        android:text="删除"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_20" />
</LinearLayout>