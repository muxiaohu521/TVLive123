<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/vs_720"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_danmu_setting_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="新增直播源"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_26"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:text="名称："
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_22" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_dialog_api_input"
        android:hint="请输入源名称"
        android:imeOptions="actionNext|flagNoExtractUi"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true"
        android:padding="@dimen/vs_10"
        android:textColor="@color/dialog_text_primary"
        android:textColorHint="@color/dialog_text_hint"
        android:textSize="@dimen/ts_24" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:text="网址："
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_22" />

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_dialog_api_input"
        android:hint="请输入直播源地址"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:inputType="textUri"
        android:maxLines="1"
        android:singleLine="true"
        android:padding="@dimen/vs_10"
        android:textColor="@color/dialog_text_primary"
        android:textColorHint="@color/dialog_text_hint"
        android:textSize="@dimen/ts_24" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_10"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_12"
            android:text="取消"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_10"
            android:layout_marginLeft="@dimen/vs_10"
            android:layout_weight="1"
            android:background="@drawable/button_danmu_setting"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_12"
            android:text="确定"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22" />
    </LinearLayout>
</LinearLayout>